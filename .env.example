# ==========================================
# Engdis Autopilot Environment Configuration
# ==========================================

# OpenAI-Compatible API Endpoint (OpenAI, vLLM, Ollama, OpenRouter, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Course Automation Parameters
ED_UNIT=0
ED_PASSES=1
ED_DRY_RUN=1
ED_CDP_PORT=9225

# Course Authentication (Alternative to ED_CRED file)
# ED_USER=your_username
# ED_PASS=your_password

# Paths & Credentials
ED_CRED=/opt/data/.config/engdis/cred
ED_SCRATCH=/tmp/ed22_scratch
ED_REPORT_DIR=.
