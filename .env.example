# ==========================================
# Engdis Autopilot Environment Configuration
# ==========================================

# --- Core Credentials & LLM Configuration ---
ED_USER=your_username
ED_PASS=your_password
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Course Automation Parameters ---
# ED_COURSE=a3             # Name, shorthand (a1, a2, a3, i1, i2, i3, b3), or numeric CourseId
ED_UNIT=0
ED_PASSES=1
ED_DRY_RUN=1
ED_CDP_PORT=9225

# --- Optional Paths & Overrides ---
# ED_CRED=/path/to/cred    # Alternative to ED_USER/ED_PASS (format: username:password)
ED_SCRATCH=/tmp/ed22_scratch
ED_REPORT_DIR=.
