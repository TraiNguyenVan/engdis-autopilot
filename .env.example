# ==========================================
# Engdis Autopilot Environment Configuration
# ==========================================

# --- Core Credentials & LLM Configuration ---
ED_USER=your_username
ED_PASS=your_password

# LLM Reasoning (AnyRouter free tier recommended — get key at https://anyrouter.dev/keys)
OPENAI_API_KEY=your_anyrouter_api_key_here
OPENAI_BASE_URL=https://anyrouter.dev/api/v1
OPENAI_MODEL=anyrouter/free

# --- Audio Transcription (Groq Whisper recommended — get free key at https://console.groq.com/keys) ---
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Alternative Endpoint Presets (Uncomment to use instead of AnyRouter) ---
# 1. Google AI Studio (Free tier, multimodal audio + vision support):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=your_gemini_api_key
#
# 2. OpenRouter Free Tier:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-exp:free
# OPENAI_API_KEY=your_openrouter_api_key
#
# 3. Standard OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key

# --- Course Automation Parameters (Uncomment to set) ---
# ED_COURSE=<course_shorthand_or_name>   # Optional: e.g. a1, a2, a3, i1, i2, i3, b3, or numeric CourseId
# ED_UNIT=<unit_index_or_range>           # e.g. 0, 0-9, or comma-separated indices
# ED_PASSES=<retry_pass_count>            # e.g. 1 or 2
# ED_DRY_RUN=<0_or_1>                     # 1 = audit only, 0 = active execution
# ED_CDP_PORT=<cdp_port>                  # default: 9225

# --- Optional Paths & Overrides (Uncomment to set) ---
# ED_CRED=<path_to_cred_file>           # Alternative to ED_USER/ED_PASS (format: username:password)
# ED_SCRATCH=<path_to_scratch_dir>        # e.g. /tmp/ed22_scratch
# ED_REPORT_DIR=<path_to_report_dir>      # e.g. .
